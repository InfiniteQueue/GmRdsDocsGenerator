<UserControl x:Class="GmRdsDocsGenerator.DataEntryControls.FieldEntry"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GmRdsDocsGenerator.DataEntryControls"
             mc:Ignorable="d" 
             x:Name="root"
             Height="auto"
             d:DesignHeight="450" d:DesignWidth="800" Margin="2.5" >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="Header" Width="auto" MinWidth="{Binding ActualWidth, ElementName=lbl}"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <Label x:Name="lbl" Grid.Column="0" Content="{Binding Title, ElementName=root}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <TextBox Text="{Binding Value, Mode=TwoWay,ElementName=root}" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" MinWidth="200"/>
    </Grid>
</UserControl>
