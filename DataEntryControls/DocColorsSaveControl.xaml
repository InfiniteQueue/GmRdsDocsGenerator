<UserControl x:Class="GmRdsDocsGenerator.DataEntryControls.ViewSetupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GmRdsDocsGenerator.DataEntryControls"
             xmlns:Models="clr-namespace:GmRdsDocsGenerator.Models"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <Models:DocumentJobModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Vertical">
        <Button x:Name="btnAutoViewSetup" Content="Build document view state from assigned parts" Click="btnAutoViewSetup_Click"/>
        <Button x:Name="btnOverwrite" Content="Write current view to document view state" Click="btnOverwrite_Click"/>
        <Button x:Name="btnRestore" Content="Restore original cell view state" Click="btnRestore_Click"/>
    </StackPanel>
</UserControl>
