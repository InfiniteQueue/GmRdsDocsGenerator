<UserControl x:Class="GmRdsDocsGenerator.Controls.DataEntryControls.CategoryAssignmentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="Colour selected objects:"/>
        <DockPanel Grid.Column="1" LastChildFill="False" x:Name="pnlAssignColours">
            <DockPanel.Resources>
                <Style TargetType="Button"> <Setter Property="DockPanel.Dock" Value="Top"/>
                    <Setter Property="Margin" Value="2"/>
                </Style>
                <Style TargetType="StackPanel"> <Setter Property="DockPanel.Dock" Value="Top"/> </Style>
            </DockPanel.Resources>
            <!--Button Content="Robot" />
            <Button Content="Gripper" />
            <Button Content="Fencing" />
            <Button Content="CPC Shared Zones" />
            <Button Content="CPC Shared Zones (CSC)" />
            <Button Content="CPC Restricted Zones" />
            <Button Content="CPC Restricted Zones (CSC)" /-->
        </DockPanel>
    </Grid>
</UserControl>
