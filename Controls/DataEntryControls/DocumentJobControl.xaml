<UserControl x:Class="GmRdsDocsGenerator.Controls.DataEntryControls.DocumentJobControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:DataEntryControls="clr-namespace:GmRdsDocsGenerator.Controls.DataEntryControls"
             xmlns:ActionControls="clr-namespace:GmRdsDocsGenerator.Controls.ActionControls"
             xmlns:Models="clr-namespace:GmRdsDocsGenerator.Models"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" x:Name="ctrlDocumentJob">
    <UserControl.DataContext>
        <Models:DocumentJobModel/>
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Button x:Name="btnDebug" Content="Debug" Click="btnDebug_Click" Grid.Row="1"/>
        <TabControl>
            <TabItem Header="Sim Objects">
                <DataEntryControls:SimObjectsControl x:Name="ctrlSimObjects" DataContext="{Binding SimObjects}"/>
            </TabItem>
            <TabItem Header="Data">
                <DataEntryControls:MainDataControl x:Name="ctrlMainData" VerticalAlignment="Top" DataContext="{Binding MainData}"/>
            </TabItem>
            <TabItem Header="View Setup">
                <DataEntryControls:ViewSetupControl HorizontalAlignment="Center" DataContext="{Binding DataContext, ElementName=ctrlDocumentJob}"/>
            </TabItem>
            <TabItem Header="Categories">
                <DataEntryControls:CategoryAssignmentControl DataContext="{Binding DataContext, ElementName=ctrlDocumentJob}"/>
            </TabItem>
            <TabItem Header="Activate Views">
                <ActionControls:ViewSetupControl DataContext="{Binding ViewStates}"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
