<UserControl x:Class="GmRdsDocsGenerator.Controls.ActionControls.ViewSetupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GmRdsDocsGenerator.Controls.ActionControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Orientation="Vertical">
        <Button Content="DCS View" Click="DCSSetup"/>
        <Button Content="DCS Top" Click="DcsTop"/>
        <Button Content="DCS Side" Click="DcsSide"/>
        <Button Content="DCS Iso" Click="DcsIso"/>

        <Button Content="Reset" Click="Reset"/>
    </StackPanel>
</UserControl>
