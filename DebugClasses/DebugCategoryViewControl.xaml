<UserControl x:Class="GmRdsDocsGenerator.DebugClasses.DebugCategoryViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GmRdsDocsGenerator.DebugClasses"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <Button x:Name="btnRefresh" Content="Refresh" DockPanel.Dock="Right" Margin="2" Padding="8,2" Click="btnRefresh_Click"/>
            <TextBlock x:Name="txtStatus" VerticalAlignment="Center" Margin="4,0"/>
        </DockPanel>
        <TreeView x:Name="treeCategories">
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type local:DebugCategoryGroup}" ItemsSource="{Binding Items}">
                    <TextBlock>
                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="{Binding CountText, Mode=OneWay}" Foreground="Gray"/>
                    </TextBlock>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True"/>
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
    </DockPanel>
</UserControl>
